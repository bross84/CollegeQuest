{
  "name": "college-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted study app: one space per class, practice quests, homework checking, document uploads, AI tutor via Groq/OpenRouter.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node client/build.js",
    "start": "node server/index.js",
    "dev": "node client/build.js && node --watch server/index.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1"
  }
}

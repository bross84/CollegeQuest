# Copy to .env and fill in. docker compose reads it automatically.

# ---- Access ----
# Strongly recommended: one shared password for the whole app. Leave empty only on a network you fully trust,
# because anyone who can open the page can use your AI keys.
APP_PASSWORD=
# Set true when serving over HTTPS (so the sign-in cookie is marked Secure), and TRUST_PROXY=true behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
# Host port to publish (compose only).
PORT=3000

# ---- AI (set one or both; leave both empty to run without the tutor) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Which to try first. If the first fails (rate limit, outage) the next one is used.
AI_PROVIDER_ORDER=groq,openrouter

# ---- Models (optional; model names change, so check each provider's catalog) ----
# "smart" is used for checking work and explanations, "quick" for short jobs, "vision" for reading photos.
#GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_QUICK_MODEL=llama-3.1-8b-instant
#GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#OPENROUTER_MODEL=google/gemini-2.5-flash
#OPENROUTER_QUICK_MODEL=
#OPENROUTER_VISION_MODEL=

# ---- Limits ----
MAX_UPLOAD_MB=25
